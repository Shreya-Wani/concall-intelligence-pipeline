# Database connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/concall_db

# Redis connection
REDIS_URL=redis://localhost:6379

# Server configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Watcher & Ingest configuration
NSE_POLL_INTERVAL_MS=30000
BSE_POLL_INTERVAL_MS=30000
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
HTTP_INITIAL_RETRY_DELAY_MS=1000
HTTP_MAX_RETRY_DELAY_MS=10000
